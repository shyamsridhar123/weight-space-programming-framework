  "reader_questions": [
    {
      "question": "What changes when an edit protects another output?",
      "answer_path": "docs/weight-space/v2/worked-example.md",
      "mechanism": "Target equality and protected directions constrain the same update. Compatible constraints intersect; protecting the target makes the requested change infeasible."
    },
    {
      "question": "How does a candidate become an evaluated artifact?",
      "answer_path": "docs/weight-space/v2/workflow.md",
      "mechanism": "The caller validates and ranks candidates, records selection, seals it, and supplies evaluation results. The receipt binds records; it does not attest historical execution."
    },
    {
      "question": "What did the original report and local study establish?",
      "answer_paths": [
        "docs/weight-space/v2/source-review.md",
        "docs/weight-space/v2/methods.md",
        "docs/weight-space/v2/results.md"
      ],
      "mechanism": "Separate original tasks and restrictions from local synthetic output-head studies, retain negative/no-op outcomes, and report the target-retention tradeoff with normalized errors and uncertainty."
    },
    {
      "question": "Which premises support a guarantee?",
      "answer_paths": [
        "docs/weight-space/v2/formal.md",
        "PROOFS.md"
      ],
      "mechanism": "Feature-span and sequential real-valued results depend on declared endpoints, coordinates, domains, and hypotheses. Runtime extraction, compilation, native arithmetic, and candidate-to-proof binding remain separate obligations."
    },
    {
      "question": "What evidence is needed next?",
      "answer_paths": [
        "docs/weight-space/v2/limitations-and-next-steps.md",
        "ROADMAP.md"
      ],
      "mechanism": "Define questions, controls, fresh units, access conditions, and acceptance/rejection criteria before claiming stronger scope."
    }
