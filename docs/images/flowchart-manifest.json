    {
      "id": "evidence-branches",
      "title": "Three evidence branches",
      "original_source_document": "docs/weight-space/design.md",
      "original_source_fence_start_line": 15,
      "original_source_diagram_sha256": "03657c937ea85a581ef7462dc1de514049c4142a14da3fe708d75cdd8e405f24",
      "alt_text": "Three distinct evidence branches. Examples, rules, an optimizer, or an LLM proposal and a named tensor artifact with interface metadata feed a program with exact-parent and cell preconditions. Its candidate artifact branches to a structural policy, an explicit architecture adapter followed by a supported semantic contract, and a caller evaluator with held-out task trials. All branches feed recorded identities and receipts. Evidence from one branch does not substitute for another.",
      "caller_and_scope_notes": [
        "Each branch establishes a different claim; none substitutes for another."
      ],
