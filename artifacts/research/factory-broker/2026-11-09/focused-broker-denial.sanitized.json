    "cases": [
      {
        "behavior_checked": "Prior JSON receipt bytes survive nonfinite data rejection and an interrupted atomic replacement.",
        "name": "test_json_checkpoint_preserves_previous_receipt_when_replace_fails",
        "status": "passed"
      },
      {
        "behavior_checked": "Rounded weights expose only the configured precision; three submissions expose only opaque handles. Forward, activation, evaluation, feedback, filesystem, network, execution, usage, audit and candidate requests are denied and recorded. Serialized public responses exclude the exact parent digest and value, private metadata, hidden test metadata, endpoint hash and no-op status. Selection seals before trusted evaluation and subsequent weight/metadata access is denied.",
        "name": "test_opaque_submission_and_all_denied_routes_are_recorded",
        "status": "passed"
      },
      {
        "behavior_checked": "Whole-tensor and undeclared-coordinate requests are denied; the declared coordinate is accessible. An invalid submission exposes only status and an opaque handle. Candidate and feedback requests return only denial. Selecting that invalid submission does not call the evaluator and is audited as invalid.",
        "name": "test_subset_and_invalid_selection_do_not_release_endpoint_state",
        "status": "passed"
      },
      {
        "behavior_checked": "Synthetic event parsing detects a started command event and retains a diagnostic warning. The existing missing-CLI monkeypatch exercises startup-failure accounting without starting a provider process.",
        "name": "test_provider_failure_accounting_and_started_tool_detection",
        "status": "passed"
      },
      {
        "behavior_checked": "A synthetic private-profile path is redacted from the event derivative while raw and public SHA-256 identities and the redaction count remain linked.",
