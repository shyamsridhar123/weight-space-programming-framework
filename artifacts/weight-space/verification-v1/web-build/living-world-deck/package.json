{
  "name": "crown-and-charter-presentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node serve.mjs",
    "test": "node runtime/server.test.mjs",
    "sync:manifest": "node runtime/sync-manifest.mjs",
    "prepare:hyperframes": "node runtime/prepare-hyperframes.mjs",
    "present": "node runtime/prepare-hyperframes.mjs && npx --yes hyperframes@0.8.181 present .hyperframes-project",
    "check:hyperframes": "node runtime/prepare-hyperframes.mjs && npx --yes hyperframes@0.8.181 check .hyperframes-project --snapshots --at 1,13,58,70,82,94,106,118"
  }
}
